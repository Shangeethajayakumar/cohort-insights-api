# Copy this file to .env before starting the application. Do not commit .env.
# URLs for running Python directly on your computer.
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=cohort_insights
REDIS_URL=redis://localhost:6379/0

# Compose uses these URLs inside containers, where localhost is not the database.
DOCKER_MONGO_URL=mongodb://mongodb:27017
DOCKER_REDIS_URL=redis://redis:6379/0

# Demo credentials only. Replace before any shared or public deployment.
# JSON maps bearer API keys to their authenticated user IDs.
API_KEYS={"demo-alice-key":"alice","demo-bob-key":"bob"}

# Only completed-result cache entries expire; active reservations do not.
CACHE_TTL_SECONDS=3600

# Parallel stages per worker process; the per-user active-document limit is 3.
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=0.5

# Default simulated durations and independent failure probability per attempt.
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=20
ENRICHING_MIN_SECONDS=5
ENRICHING_MAX_SECONDS=15
FAILURE_PROBABILITY=0.1

# Failed stages retry after 2 seconds, then 4 seconds; third failure is terminal.
MAX_STAGE_ATTEMPTS=3
RETRY_BASE_SECONDS=2

# Must exceed each stage's maximum duration, with room for database operations.
LEASE_SECONDS=60